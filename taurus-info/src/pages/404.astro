---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" noindex>
  <section class="not-found">
    <div class="container-shell">
      <span>404</span>
      <h1>Questa pagina è fuori spartito.</h1>
      <p>Il contenuto potrebbe essere stato spostato oppure l’indirizzo non è corretto.</p>
      <a class="button-primary" href="/">Torna alla pagina iniziale</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: 65vh; place-items: center; padding-block: 5rem; text-align: center; }
  .not-found span { color: var(--color-moss-500); font-family: var(--font-display); font-size: 1.2rem; }
  h1 { max-width: 13ch; margin: 1rem auto 0; font-family: var(--font-display); font-size: clamp(2.5rem,7vw,5rem); font-weight: 500; letter-spacing: -.05em; line-height: 1; }
  p { max-width: 35rem; margin: 1.5rem auto 2rem; color: var(--color-ink-600); line-height: 1.7; }
</style>

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260928000001-1" author="taurus">
    <comment>Loan data on inventory items, assignments and returns.</comment>
    <addColumn tableName="inventory_item">
      <column name="brand_model" type="varchar(255)"/>
      <column name="serial_number" type="varchar(128)"/>
      <column name="loan_type" type="varchar(32)"/>
    </addColumn>
    <addColumn tableName="inventory_assignment">
      <column name="accessories" type="varchar(500)"/>
      <column name="loan_sheet_id" type="bigint"/>
      <column name="replaces_assignment_id" type="bigint"/>
    </addColumn>
    <addColumn tableName="inventory_return">
      <column name="reason" type="varchar(32)" defaultValue="STANDARD">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <addForeignKeyConstraint baseTableName="inventory_assignment" baseColumnNames="replaces_assignment_id"
                             referencedTableName="inventory_assignment" referencedColumnNames="id"
                             constraintName="fk_inventory_assignment_replaces" onDelete="RESTRICT"/>
  </changeSet>

  <changeSet id="20260928000001-2" author="taurus">
    <comment>Immutable versions of the loan sheet template and settings of the tenant.</comment>
    <createTable tableName="inventory_loan_template">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="version_number" type="integer"/>
      <column name="origin" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="default_label" type="varchar(32)"/>
      <column name="file_name" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="content" type="text">
        <constraints nullable="false"/>
      </column>
      <column name="content_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createTable tableName="inventory_loan_settings">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="active_template_id" type="bigint"/>
      <column name="min_months" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="max_months" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="renewal_max_months" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="total_max_months" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="inventory_loan_settings" baseColumnNames="active_template_id"
                             referencedTableName="inventory_loan_template" referencedColumnNames="id"
                             constraintName="fk_inventory_loan_settings_template" onDelete="RESTRICT"/>
  </changeSet>


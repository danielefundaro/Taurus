---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Porta ordine in tutta la tua organizzazione.',
  text = 'Scopri come Taurus può collegare patrimonio, attività, materiali e gestione economica.'
} = Astro.props;
---

<section class="cta-section">
  <div class="container-shell cta-card">
    <div>
      <span class="eyebrow">Inizia da qui</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="button-primary" href={`mailto:${siteConfig.contactEmail}?subject=Richiesta informazioni Taurus`}>Parliamone <Icon name="mail" size={18} /></a>
      <a class="button-secondary" href={siteConfig.appUrl}>Accedi alla piattaforma <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>

<style>
  .cta-section { padding: 1rem 0 clamp(4.5rem, 9vw, 8rem); }
  .cta-card { display: flex; align-items: end; justify-content: space-between; gap: 3rem; overflow: hidden; border-radius: 2rem; padding: clamp(2rem, 6vw, 4.5rem); color: white; background: radial-gradient(circle at 88% 15%, rgba(231, 167, 68, .22), transparent 18rem), var(--color-moss-900); }
  .cta-card :global(.eyebrow) { color: var(--color-moss-200); }
  h2 { max-width: 13ch; margin: 1rem 0 0; font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.8rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.05; }
  p { max-width: 37rem; margin: 1rem 0 0; color: rgba(255,255,255,.68); font-size: 1.05rem; line-height: 1.7; }
  .cta-actions { display: flex; min-width: fit-content; flex-direction: column; gap: .75rem; }
  .cta-actions :global(.button-primary) { color: var(--color-moss-900); background: white; }
  .cta-actions :global(.button-secondary) { border-color: rgba(255,255,255,.25); color: white; background: rgba(255,255,255,.08); }
  @media (max-width: 850px) { .cta-card { align-items: flex-start; flex-direction: column; } .cta-actions { width: 100%; } }
</style>

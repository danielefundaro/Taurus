<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="20260905020001-1" author="taurus">
    <addColumn tableName="calendar_event">
      <column name="calendar_uid" type="uuid"/>
      <column name="calendar_sequence" type="integer" defaultValueNumeric="0"/>
      <column name="calendar_feed_modified_at" type="timestamp with time zone"/>
    </addColumn>
    <sql>UPDATE calendar_event SET calendar_uid = (md5(random()::text || clock_timestamp()::text || id::text))::uuid, calendar_sequence = 0, calendar_feed_modified_at = COALESCE(edit_date, insert_date, CURRENT_TIMESTAMP) WHERE calendar_uid IS NULL</sql>
    <sql>ALTER TABLE calendar_event ALTER COLUMN calendar_uid SET DEFAULT (md5(random()::text || clock_timestamp()::text))::uuid, ALTER COLUMN calendar_feed_modified_at SET DEFAULT CURRENT_TIMESTAMP</sql>
    <addNotNullConstraint tableName="calendar_event" columnName="calendar_uid" columnDataType="uuid"/>
    <addNotNullConstraint tableName="calendar_event" columnName="calendar_sequence" columnDataType="integer"/>
    <addNotNullConstraint tableName="calendar_event" columnName="calendar_feed_modified_at" columnDataType="timestamp with time zone"/>
    <addUniqueConstraint tableName="calendar_event" columnNames="calendar_uid" constraintName="uq_calendar_event_calendar_uid"/>

    <createTable tableName="calendar_feed_subscription">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="name" type="varchar(120)"><constraints nullable="false"/></column>
      <column name="feed_type" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="owner_user_id" type="bigint"/>
      <column name="visibility_scope" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="detail_level" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="past_days" type="integer" defaultValueNumeric="90"><constraints nullable="false"/></column>
      <column name="future_months" type="integer" defaultValueNumeric="18"><constraints nullable="false"/></column>
      <column name="status" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="token_version" type="integer"><constraints nullable="false"/></column>
      <column name="token_fingerprint" type="varchar(12)"><constraints nullable="false"/></column>
      <column name="last_accessed_at" type="timestamp with time zone"/>
      <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
      <column name="created_by" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="updated_at" type="timestamp with time zone"><constraints nullable="false"/></column>
      <column name="updated_by" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="entity_version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="calendar_feed_subscription" baseColumnNames="owner_user_id" referencedTableName="app_user" referencedColumnNames="id" constraintName="fk_calendar_feed_owner" onDelete="RESTRICT"/>
    <createIndex tableName="calendar_feed_subscription" indexName="idx_calendar_feed_owner_status"><column name="owner_user_id"/><column name="status"/></createIndex>
    <createIndex tableName="calendar_feed_subscription" indexName="idx_calendar_feed_type_status"><column name="feed_type"/><column name="status"/></createIndex>
    <sql>ALTER TABLE calendar_feed_subscription ADD CONSTRAINT chk_calendar_feed_subscription CHECK (feed_type IN ('PERSONAL','TENANT') AND visibility_scope IN ('INTERNAL','PUBLIC_ONLY') AND detail_level IN ('MINIMAL','STANDARD') AND status IN ('ACTIVE','REVOKED') AND past_days BETWEEN 0 AND 365 AND future_months BETWEEN 1 AND 36 AND ((feed_type='PERSONAL' AND owner_user_id IS NOT NULL) OR (feed_type='TENANT' AND owner_user_id IS NULL)))</sql>

    <createTable tableName="calendar_event_feed_tombstone">
      <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="event_uid" type="uuid"><constraints nullable="false"/></column>
      <column name="audience" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="sequence" type="integer"><constraints nullable="false"/></column>
      <column name="original_start_date" type="timestamp with time zone"><constraints nullable="false"/></column>
      <column name="original_end_date" type="timestamp with time zone"><constraints nullable="false"/></column>
      <column name="summary_snapshot" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="cancelled_at" type="timestamp with time zone"><constraints nullable="false"/></column>
      <column name="expires_at" type="timestamp with time zone"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="calendar_event_feed_tombstone" columnNames="event_uid,audience" constraintName="uq_calendar_feed_tombstone"/>
    <createIndex tableName="calendar_event_feed_tombstone" indexName="idx_calendar_feed_tombstone_window"><column name="audience"/><column name="expires_at"/><column name="original_start_date"/></createIndex>
    <sql>ALTER TABLE calendar_event_feed_tombstone ADD CONSTRAINT chk_calendar_feed_tombstone_audience CHECK (audience IN ('INTERNAL','EXTERNAL'))</sql>
  </changeSet>
</databaseChangeLog>

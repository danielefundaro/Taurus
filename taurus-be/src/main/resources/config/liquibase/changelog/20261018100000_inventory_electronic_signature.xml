  <changeSet id="20261018100000-3" author="taurus">
    <comment>Requests of a confirmation code, removed some time after they are closed.</comment>
    <createTable tableName="signature_challenge">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="purpose" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="method" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="user_keycloak_id" type="varchar(255)"/>
      <column name="destination_email" type="varchar(255)"/>
      <column name="code_digest" type="varchar(64)"/>
      <column name="items_json" type="text">
        <constraints nullable="false"/>
      </column>
      <column name="items_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="expires_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="attempts" type="integer" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="sends" type="integer" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="last_sent_at" type="timestamp with time zone"/>
      <column name="status" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="confirmed_at" type="timestamp with time zone"/>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet id="20261018100000-4" author="taurus">
    <comment>Immutable evidence of every signature, chained by hash within the tenant.</comment>
    <createTable tableName="signature_evidence">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="sequence" type="bigint">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_signature_evidence_sequence"/>
      </column>
      <column name="act_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="document_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="signer_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="purpose" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="method" type="varchar(24)">
        <constraints nullable="false"/>
      </column>
      <column name="document_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="declaration_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="revocation_check" type="varchar(16)"/>
      <!-- Not a foreign key: closed challenges are removed, the evidence stays. -->
      <column name="challenge_id" type="bigint"/>
      <column name="signed_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="declaration_text" type="text"/>
      <column name="signer_name" type="varchar(255)"/>
      <column name="signer_keycloak_id" type="varchar(255)"/>
      <column name="destination_email" type="varchar(255)"/>
      <column name="certificate_subject" type="varchar(1000)"/>
      <column name="certificate_issuer" type="varchar(1000)"/>
      <column name="certificate_serial" type="varchar(128)"/>
      <column name="certificate_tax_code" type="varchar(32)"/>
      <column name="session_id" type="varchar(255)"/>
      <column name="ip_address" type="varchar(64)"/>
      <column name="user_agent" type="varchar(512)"/>
      <column name="personal_data_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="previous_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="evidence_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="purged_at" type="timestamp with time zone"/>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="signature_evidence" baseColumnNames="act_id"
                             referencedTableName="signature_act" referencedColumnNames="id"
                             constraintName="fk_signature_evidence_act" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_evidence" baseColumnNames="document_id"
                             referencedTableName="signature_document" referencedColumnNames="id"
                             constraintName="fk_signature_evidence_document" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_evidence" baseColumnNames="signer_id"
                             referencedTableName="signature_act_signer" referencedColumnNames="id"
                             constraintName="fk_signature_evidence_signer" onDelete="RESTRICT"/>

    <createTable tableName="signature_chain_head">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="last_sequence" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="last_hash" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addColumn tableName="inventory_assignment_decision">
      <column name="signature_evidence_id" type="bigint"/>
    </addColumn>
    <addForeignKeyConstraint baseTableName="inventory_assignment_decision" baseColumnNames="signature_evidence_id"
                             referencedTableName="signature_evidence" referencedColumnNames="id"
                             constraintName="fk_inventory_assignment_decision_evidence" onDelete="RESTRICT"/>
  </changeSet>

  <changeSet id="20261018100000-5" author="taurus" dbms="postgresql">
    <comment>Indexes, consistency checks, the chain head row and the protection of the evidence.</comment>
    <sql splitStatements="false"><![CDATA[
      CREATE UNIQUE INDEX uq_signature_document_role ON signature_document (act_id, role) WHERE deleted = false;
      CREATE INDEX idx_signature_act_sheet ON signature_act (sheet_id) WHERE sheet_id IS NOT NULL;
      CREATE INDEX idx_signature_act_assignment ON signature_act (assignment_id) WHERE assignment_id IS NOT NULL;
      CREATE INDEX idx_signature_act_purge ON signature_act (purge_after) WHERE purged_at IS NULL AND purge_after IS NOT NULL;
      CREATE INDEX idx_signature_act_signer_act ON signature_act_signer (act_id);
      CREATE INDEX idx_signature_act_signer_user ON signature_act_signer (user_keycloak_id, status) WHERE deleted = false;
      CREATE INDEX idx_signature_challenge_user ON signature_challenge (user_keycloak_id);
      CREATE INDEX idx_signature_challenge_cleanup ON signature_challenge (expires_at);
      CREATE INDEX idx_signature_evidence_act ON signature_evidence (act_id);
      CREATE INDEX idx_signature_evidence_signer_user ON signature_evidence (signer_keycloak_id) WHERE signer_keycloak_id IS NOT NULL;
      CREATE UNIQUE INDEX uq_signature_chain_head_single ON signature_chain_head ((true)) WHERE deleted = false;

      ALTER TABLE signature_act
        ADD CONSTRAINT ck_signature_act_type CHECK (act_type IN ('LOAN_SHEET_ISSUE', 'LOAN_SHEET_VARIATION', 'LOAN_SHEET_RETURN', 'ASSIGNMENT_ACKNOWLEDGMENT')),
        ADD CONSTRAINT ck_signature_act_status CHECK (status IN ('AWAITING_DATA', 'AWAITING_SIGNATURES', 'SIGNED', 'SIGNED_ON_PAPER', 'CANCELLED')),
        ADD CONSTRAINT ck_signature_act_origin CHECK (
          (act_type = 'ASSIGNMENT_ACKNOWLEDGMENT' AND assignment_id IS NOT NULL AND decision_id IS NOT NULL)
          OR (act_type <> 'ASSIGNMENT_ACKNOWLEDGMENT' AND sheet_id IS NOT NULL)
        );
      ALTER TABLE signature_document
        ADD CONSTRAINT ck_signature_document_role CHECK (role IN ('MAIN', 'CLAUSES', 'SNAPSHOT'));
      ALTER TABLE signature_act_signer
        ADD CONSTRAINT ck_signature_act_signer_role CHECK (signer_role IN ('HOLDER', 'MINOR', 'ASSOCIATION', 'ASSIGNEE')),
        ADD CONSTRAINT ck_signature_act_signer_status CHECK (status IN ('PENDING', 'SIGNED', 'SIGNED_ON_PAPER'));
      ALTER TABLE signature_challenge
        ADD CONSTRAINT ck_signature_challenge_method CHECK (method IN ('EMAIL_OTP', 'TOTP')),
        ADD CONSTRAINT ck_signature_challenge_status CHECK (status IN ('OPEN', 'CONFIRMED', 'EXPIRED', 'LOCKED', 'CANCELLED'));
      ALTER TABLE signature_evidence
        ADD CONSTRAINT ck_signature_evidence_method CHECK (method IN ('EMAIL_OTP', 'TOTP', 'CIESIGN', 'PAPER_DECLARATION'));

      INSERT INTO signature_chain_head (last_sequence, last_hash, entity_version, deleted, insert_date, insert_by, edit_date, edit_by)
      VALUES (0, repeat('0', 64), 0, false, now(), 'system', now(), 'system');

      -- Evidence rows are never deleted, and only their personal data can be removed, once.
      CREATE OR REPLACE FUNCTION signature_evidence_guard() RETURNS trigger AS $$
      BEGIN
        IF TG_OP = 'DELETE' THEN
          RAISE EXCEPTION 'signature evidence cannot be deleted';
        END IF;
        IF NEW.sequence IS DISTINCT FROM OLD.sequence
          OR NEW.act_id IS DISTINCT FROM OLD.act_id
          OR NEW.document_id IS DISTINCT FROM OLD.document_id
          OR NEW.signer_id IS DISTINCT FROM OLD.signer_id
          OR NEW.purpose IS DISTINCT FROM OLD.purpose
          OR NEW.method IS DISTINCT FROM OLD.method
          OR NEW.document_hash IS DISTINCT FROM OLD.document_hash
          OR NEW.declaration_hash IS DISTINCT FROM OLD.declaration_hash
          OR NEW.revocation_check IS DISTINCT FROM OLD.revocation_check
          OR NEW.challenge_id IS DISTINCT FROM OLD.challenge_id
          OR NEW.signed_at IS DISTINCT FROM OLD.signed_at
          OR NEW.personal_data_hash IS DISTINCT FROM OLD.personal_data_hash
          OR NEW.previous_hash IS DISTINCT FROM OLD.previous_hash
          OR NEW.evidence_hash IS DISTINCT FROM OLD.evidence_hash
          OR NEW.deleted IS DISTINCT FROM OLD.deleted
          OR OLD.purged_at IS NOT NULL
          OR NEW.purged_at IS NULL
          OR NEW.declaration_text IS NOT NULL
          OR NEW.signer_name IS NOT NULL
          OR NEW.signer_keycloak_id IS NOT NULL
          OR NEW.destination_email IS NOT NULL
          OR NEW.certificate_subject IS NOT NULL
          OR NEW.certificate_issuer IS NOT NULL
          OR NEW.certificate_serial IS NOT NULL
          OR NEW.certificate_tax_code IS NOT NULL
          OR NEW.session_id IS NOT NULL
          OR NEW.ip_address IS NOT NULL
          OR NEW.user_agent IS NOT NULL THEN
          RAISE EXCEPTION 'signature evidence is immutable: only the removal of its personal data is allowed';
        END IF;
        RETURN NEW;
      END;
      $$ LANGUAGE plpgsql;

      CREATE TRIGGER trg_signature_evidence_guard
        BEFORE UPDATE OR DELETE ON signature_evidence
        FOR EACH ROW EXECUTE FUNCTION signature_evidence_guard();
      ]]></sql>
  </changeSet>
</databaseChangeLog>

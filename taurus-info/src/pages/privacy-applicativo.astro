---
import { appLegalUrl } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// L'informativa dell'applicativo si scrive e si versiona in Taurus: il vecchio indirizzo rimanda alla pagina pubblica.
const target = appLegalUrl('privacy');
---

<BaseLayout title="Privacy dell’applicativo" description="L’informativa privacy della piattaforma Taurus è pubblicata nell’applicativo, con tutte le versioni." redirectTo={target}>
  <section class="legal-hero">
    <div class="container-shell">
      <span class="eyebrow">Piattaforma Taurus</span>
      <h1 class="display-title">Privacy dell’applicativo</h1>
      <p class="body-large">L’informativa privacy è pubblicata nell’applicativo, insieme alle versioni precedenti.</p>
      <p class="body-large"><a class="redirect-link" href={target}>Apri l’informativa privacy dell’applicativo</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .redirect-link {
    font-weight: 700;
    text-decoration: underline;
  }
</style>

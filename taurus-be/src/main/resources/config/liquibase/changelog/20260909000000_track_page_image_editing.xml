<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260909000000-1" author="taurus">
    <createTable tableName="track_page_edit_receipt">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="request_key" type="UUID"><constraints nullable="false"/></column>
      <column name="requested_by" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="request_fingerprint" type="CHAR(64)"><constraints nullable="false"/></column>
      <column name="track_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="sheet_music_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="source_media_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="result_media_asset_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="result_track_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="result_media_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
      <column name="result_media_order" type="BIGINT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
    </createTable>
    <addUniqueConstraint tableName="track_page_edit_receipt" columnNames="requested_by,request_key" constraintName="uq_track_page_edit_receipt_actor_key"/>
    <addForeignKeyConstraint baseTableName="track_page_edit_receipt" baseColumnNames="track_id" referencedTableName="track" referencedColumnNames="id" constraintName="fk_track_page_edit_receipt_track" onDelete="CASCADE"/>
    <addForeignKeyConstraint baseTableName="track_page_edit_receipt" baseColumnNames="sheet_music_id" referencedTableName="sheet_music" referencedColumnNames="id" constraintName="fk_track_page_edit_receipt_score" onDelete="CASCADE"/>
    <createIndex tableName="track_page_edit_receipt" indexName="idx_track_page_edit_receipt_created"><column name="created_at"/></createIndex>
  </changeSet>
</databaseChangeLog>

{
    "name": "taurus-fe",
    "version": "0.0.1",
    "scripts": {
        "ng": "ng",
        "prestart": "node scripts/fetch-soundfont.mjs",
        "start": "ng serve",
        "prebuild": "node scripts/fetch-soundfont.mjs",
        "build": "ng build",
        "update": "ng update",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "test": "ng test",
        "test:coverage": "node scripts/check-coverage.mjs",
        "check:tour-anchors": "node scripts/check-tour-anchors.mjs && node --test scripts/check-tour-anchors.test.mjs",
        "e2e": "playwright test --config e2e/playwright.config.ts --project=desktop --project=mobile",
        "e2e:matrix": "playwright test --config e2e/playwright.config.ts",
        "e2e:install": "playwright install --with-deps chromium firefox webkit"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^19.2.25",
        "@angular/cdk": "^19.2.19",
        "@angular/common": "^19.2.25",
        "@angular/compiler": "^19.2.25",
        "@angular/core": "^19.2.25",
        "@angular/forms": "^19.2.25",
        "@angular/platform-browser": "^19.2.25",
        "@angular/platform-browser-dynamic": "^19.2.25",
        "@angular/router": "^19.2.25",
        "@angular/service-worker": "^19.2.25",
        "@primeng/themes": "^19.1.4",
        "chart.js": "4.4.2",
        "keycloak-angular": "^19.0.2",
        "keycloak-js": "^26.1.4",
        "lato-font": "^3.0.0",
        "ngx-extended-pdf-viewer": "^28.1.2",
        "primeclt": "^0.1.5",
        "primeicons": "^7.0.0",
        "primeng": "^19.0.10",
        "rxjs": "~7.8.0",
        "spessasynth_lib": "4.3.14",
        "tailwindcss-primeui": "^0.5.1",
        "tslib": "^2.3.0",
        "verovio": "6.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^21.2.29",
        "@angular/cli": "^19.2.27",
        "@angular/compiler-cli": "^19.2.25",
        "@axe-core/playwright": "^4.10.1",
        "@playwright/test": "^1.49.1",
        "@types/jasmine": "~5.1.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^4.2.1",
        "jasmine-core": "~5.4.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.18",
        "prettier": "^3.0.0",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.6.2"
    }
}

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260909010000-1" author="taurus">
    <addColumn tableName="track_page_edit_receipt">
      <column name="result_media_json" type="TEXT"/>
    </addColumn>
    <sql>
      UPDATE track_page_edit_receipt
      SET result_media_json = json_build_array(
        json_build_object(
          'index', result_media_asset_id,
          'name', result_media_name,
          'order', result_media_order
        )
                              )::text
    </sql>
    <addNotNullConstraint tableName="track_page_edit_receipt" columnName="result_media_json" columnDataType="TEXT"/>
    <sql>ALTER TABLE track_page_edit_receipt DROP CONSTRAINT IF EXISTS fk_track_page_edit_receipt_result</sql>
    <dropColumn tableName="track_page_edit_receipt" columnName="result_media_asset_id"/>
    <dropColumn tableName="track_page_edit_receipt" columnName="result_media_name"/>
    <dropColumn tableName="track_page_edit_receipt" columnName="result_media_order"/>
  </changeSet>
</databaseChangeLog>

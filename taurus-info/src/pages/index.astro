---
import CallToAction from '../components/CallToAction.astro';
import DashboardPreview from '../components/DashboardPreview.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  { icon: 'catalogue', title: 'Patrimonio musicale', description: 'Album, tracce, partiture, PDF e strumenti restano collegati, ricercabili e pronti da consultare.', number: '01' },
  { icon: 'calendar', title: 'Calendario operativo', description: 'Eventi singoli o ricorrenti, disponibilità, presenze, costi e promemoria nello stesso flusso.', number: '02' },
  { icon: 'inventory', title: 'Inventario responsabile', description: 'Oggetti, fotografie, assegnazioni, prese visione, scadenze e riconsegne sempre tracciabili.', number: '03' },
  { icon: 'finance', title: 'Gestione economica', description: 'Casse, conti, movimenti, trasferimenti, budget degli eventi ed esercizi con rendiconti esportabili.', number: '04' },
  { icon: 'users', title: 'Persone e responsabilità', description: 'Ruoli dedicati consentono a ciascuno di vedere e gestire solo ciò che gli compete.', number: '05' },
  { icon: 'bell', title: 'Dashboard e notifiche', description: 'Una panoramica immediata e comunicazioni mirate mantengono visibili attività, scadenze e novità.', number: '06' }
] as const;
---

<BaseLayout>
  <section class="hero">
    <div class="container-shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Gestionale per organizzazioni musicali</span>
        <h1 class="display-title">Tutta la tua organizzazione, finalmente in armonia.</h1>
        <p class="body-large">Taurus riunisce patrimonio musicale, calendario, inventario, contabilità e persone in un unico ambiente di lavoro condiviso.</p>
        <div class="hero-actions">
          <a class="button-primary" href="/funzionalita/">Scopri Taurus <Icon name="arrow" size={19} /></a>
          <a class="button-secondary" href={siteConfig.appUrl}>Accedi alla piattaforma</a>
        </div>
        <div class="hero-points" aria-label="Caratteristiche principali">
          <span><Icon name="check" size={17} /> Multi-tenant</span>
          <span><Icon name="check" size={17} /> Dati e attività connessi</span>
          <span><Icon name="check" size={17} /> Accessi per ruolo</span>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div class="preview-wrap"><DashboardPreview /></div>
  </section>

  <section id="prodotto" class="section-space intro-section">
    <div class="container-shell intro-grid">
      <div>
        <span class="eyebrow">Un unico spazio di lavoro</span>
        <h2 class="section-title">Meno strumenti separati.<br />Più controllo quotidiano.</h2>
      </div>
      <div class="intro-copy">
        <p class="body-large">Quando catalogo, calendario, consegne e contabilità vivono in strumenti separati, anche una semplice verifica richiede tempo. Taurus collega le informazioni e le rende utili a tutta l’organizzazione.</p>
        <a href="/funzionalita/">Esplora tutte le funzionalità <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="container-shell feature-grid">
      {features.map((feature) => <FeatureCard {...feature} />)}
    </div>
  </section>

  <section class="section-space workflow-section">
    <div class="container-shell workflow-grid">
      <div class="workflow-copy">
        <span class="eyebrow">Un flusso condiviso</span>
        <h2 class="section-title">Dalla programmazione al rendiconto.</h2>
        <p class="body-large">Taurus segue il lavoro reale dell’organizzazione: prepara le attività, distribuisce responsabilità e conserva uno storico ordinato.</p>
      </div>
      <ol class="workflow-list">
        <li><span>01</span><div><h3>Organizza</h3><p>Centralizza catalogo, documenti, oggetti e informazioni operative.</p></div></li>
        <li><span>02</span><div><h3>Programma</h3><p>Crea eventi anche ricorrenti e raccogli disponibilità e presenze.</p></div></li>
        <li><span>03</span><div><h3>Assegna</h3><p>Affida materiali e responsabilità con scadenze, notifiche e presa visione.</p></div></li>
        <li><span>04</span><div><h3>Rendiconta</h3><p>Collega entrate e uscite alle attività ed esporta registri e report.</p></div></li>
      </ol>
    </div>
  </section>

  <section id="sicurezza" class="security-section">
    <div class="container-shell security-grid">
      <div class="security-visual" aria-hidden="true">
        <div class="tenant tenant-a"><span>A</span><strong>Organizzazione A</strong><small>Catalogo isolato</small></div>
        <div class="security-core"><Icon name="shield" size={40} /><span>Taurus</span></div>
        <div class="tenant tenant-b"><span>B</span><strong>Organizzazione B</strong><small>Catalogo isolato</small></div>
      </div>
      <div>
        <span class="eyebrow">Sicurezza e separazione</span>
        <h2 class="section-title">Ogni organizzazione lavora nel proprio spazio.</h2>
        <p class="body-large">Taurus combina autenticazione centralizzata, autorizzazioni applicative e schemi dati separati per mantenere distinti patrimonio, persone e attività.</p>
        <ul>
          <li><Icon name="check" size={18} /> Autenticazione OAuth 2.0 / OpenID Connect</li>
          <li><Icon name="check" size={18} /> Profili dedicati, incluso il ruolo Tesoriere</li>
          <li><Icon name="check" size={18} /> Audit, documenti legali versionati e flussi GDPR</li>
        </ul>
      </div>
    </div>
  </section>

  <CallToAction title="Un solo ambiente per far funzionare l’organizzazione." text="Raccontaci come gestisci oggi patrimonio, attività, materiali e contabilità: vedremo insieme dove Taurus può semplificare il lavoro." />
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(4.5rem, 9vw, 8rem) 0 0; }
  .hero-grid { position: relative; }
  .hero-copy { position: relative; z-index: 2; max-width: 52rem; }
  .hero-copy .body-large { max-width: 44rem; margin: 1.8rem 0 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  .hero-points { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 2rem; color: var(--color-ink-600); font-size: .84rem; font-weight: 700; }
  .hero-points span { display: inline-flex; align-items: center; gap: .35rem; }
  .hero-points :global(svg) { color: var(--color-moss-500); }
  .hero-orbit { position: absolute; top: -8rem; right: -8rem; width: 34rem; height: 34rem; border: 1px solid rgba(35,97,77,.12); border-radius: 50%; }
  .hero-orbit::before, .hero-orbit::after { position: absolute; inset: 4rem; border: 1px solid rgba(35,97,77,.1); border-radius: 50%; content: ''; }
  .hero-orbit::after { inset: 9rem; }
  .hero-orbit span { position: absolute; width: .65rem; height: .65rem; border-radius: 50%; background: var(--color-amber-400); box-shadow: 0 0 0 .5rem rgba(231,167,68,.12); }
  .hero-orbit span:first-child { top: 20%; left: 8%; } .hero-orbit span:nth-child(2) { right: 4%; bottom: 30%; background: var(--color-moss-500); } .hero-orbit span:last-child { right: 40%; bottom: 1%; background: var(--color-coral-400); }
  .preview-wrap { width: min(92rem, calc(100% - 2rem)); margin: clamp(3.5rem, 8vw, 7rem) auto 0; overflow: hidden; border-radius: 1.75rem 1.75rem 0 0; padding: 1rem 1rem 0; background: linear-gradient(145deg, rgba(185,222,207,.55), rgba(245,241,231,.9)); }
  .preview-wrap :global(.product-window) { width: 75rem; max-width: 100%; margin-inline: auto; }

  .intro-section { background: white; }
  .intro-grid { display: grid; grid-template-columns: 1.05fr .7fr; align-items: end; gap: clamp(3rem, 8vw, 8rem); }
  .intro-copy a { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1.5rem; color: var(--color-moss-700); font-weight: 800; text-decoration: none; }
  .feature-section { padding-bottom: clamp(4.5rem, 9vw, 8rem); background: white; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .workflow-section { background: var(--color-cream-100); }
  .workflow-grid { display: grid; grid-template-columns: .8fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .workflow-copy { position: sticky; top: 7rem; align-self: start; }
  .workflow-copy .body-large { margin-top: 1.5rem; }
  .workflow-list { margin: 0; padding: 0; list-style: none; }
  .workflow-list li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 2rem 0; border-bottom: 1px solid rgba(23,61,49,.14); }
  .workflow-list li:first-child { padding-top: 0; }
  .workflow-list span { color: var(--color-moss-500); font-family: var(--font-display); }
  .workflow-list h3 { margin: 0; font-family: var(--font-display); font-size: 1.55rem; font-weight: 600; }
  .workflow-list p { margin: .5rem 0 0; color: var(--color-ink-600); line-height: 1.65; }

  .security-section { padding-block: clamp(5rem, 10vw, 9rem); }
  .security-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .security-grid ul { display: grid; gap: .8rem; margin: 1.8rem 0 0; padding: 0; list-style: none; }
  .security-grid li { display: flex; align-items: center; gap: .6rem; color: var(--color-ink-800); font-weight: 700; }
  .security-grid li :global(svg) { flex: none; color: var(--color-moss-500); }
  .security-visual { position: relative; min-height: 29rem; border: 1px solid rgba(23,61,49,.1); border-radius: 2rem; background: radial-gradient(circle, rgba(185,222,207,.75), transparent 58%); }
  .security-core { position: absolute; top: 50%; left: 50%; display: grid; width: 8rem; height: 8rem; place-items: center; transform: translate(-50%,-50%); border-radius: 50%; color: white; background: var(--color-moss-900); box-shadow: 0 25px 50px rgba(23,61,49,.25); }
  .security-core span { margin-top: -1.5rem; font-family: var(--font-display); }
  .tenant { position: absolute; display: grid; grid-template-columns: auto 1fr; column-gap: .7rem; width: 12.5rem; border: 1px solid rgba(23,61,49,.12); border-radius: 1rem; padding: .9rem; background: rgba(255,255,255,.9); box-shadow: var(--shadow-soft); }
  .tenant > span { display: grid; width: 2.2rem; height: 2.2rem; grid-row: span 2; place-items: center; border-radius: .65rem; color: var(--color-moss-900); font-weight: 900; background: var(--color-moss-100); }
  .tenant strong { align-self: end; font-size: .72rem; } .tenant small { color: var(--color-ink-600); font-size: .58rem; }
  .tenant-a { top: 3rem; left: 2rem; } .tenant-b { right: 2rem; bottom: 3rem; }

  @media (max-width: 850px) {
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
    .intro-grid, .workflow-grid, .security-grid { grid-template-columns: 1fr; }
    .workflow-copy { position: static; }
    .security-visual { order: 2; }
  }
  @media (max-width: 600px) {
    .feature-grid { grid-template-columns: 1fr; }
    .hero-actions :global(a) { width: 100%; }
    .preview-wrap { overflow-x: auto; }
    .preview-wrap :global(.product-window) { width: 720px; max-width: none; }
    .security-visual { min-height: 25rem; }
    .tenant-a { top: 2rem; left: 1rem; } .tenant-b { right: 1rem; bottom: 2rem; }
  }
</style>

<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="20261017000000-1" author="taurus">
    <comment>Optical music recognition jobs of the parts.</comment>
    <createTable tableName="score_recognition_job">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="sheet_music_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="track_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="batch_id" type="uuid"/>
      <column name="pages_fingerprint" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="attempts" type="integer" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="requested_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="started_at" type="timestamp with time zone"/>
      <column name="finished_at" type="timestamp with time zone"/>
      <column name="error_code" type="varchar(64)"/>
      <column name="engines_json" type="text"/>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="score_recognition_job" baseColumnNames="sheet_music_id"
                             referencedTableName="sheet_music" referencedColumnNames="id"
                             constraintName="fk_score_recognition_job_sheet_music" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="score_recognition_job" baseColumnNames="track_id"
                             referencedTableName="track" referencedColumnNames="id"
                             constraintName="fk_score_recognition_job_track" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="score_version" baseColumnNames="recognition_job_id"
                             referencedTableName="score_recognition_job" referencedColumnNames="id"
                             constraintName="fk_score_version_recognition_job" onDelete="SET NULL"/>
    <sql><![CDATA[
      ALTER TABLE score_recognition_job
        ADD CONSTRAINT ck_score_recognition_job_status CHECK (status IN ('QUEUED', 'RUNNING', 'DONE', 'FAILED')),
        ADD CONSTRAINT ck_score_recognition_job_attempts CHECK (attempts >= 0),
        ADD CONSTRAINT ck_score_recognition_job_failure CHECK ((status = 'FAILED') = (error_code IS NOT NULL));
      CREATE UNIQUE INDEX uq_score_recognition_job_active ON score_recognition_job (sheet_music_id)
        WHERE deleted = FALSE AND status IN ('QUEUED', 'RUNNING');
      CREATE INDEX idx_score_recognition_job_track ON score_recognition_job (track_id, deleted);
      CREATE INDEX idx_score_recognition_job_status ON score_recognition_job (status, edit_date) WHERE deleted = FALSE;
      CREATE INDEX idx_score_recognition_job_batch ON score_recognition_job (batch_id) WHERE batch_id IS NOT NULL;
      CREATE INDEX idx_score_version_recognition_job ON score_version (recognition_job_id) WHERE recognition_job_id IS NOT NULL;
      ]]></sql>
  </changeSet>
</databaseChangeLog>

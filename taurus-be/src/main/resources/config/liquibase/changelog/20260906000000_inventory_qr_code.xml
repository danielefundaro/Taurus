<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260906000000-1" author="taurus" dbms="postgresql">
    <comment>Add stable QR identity to every inventory item.</comment>
    <addColumn tableName="inventory_item">
      <column name="qr_public_id" type="uuid"/>
      <column name="qr_version" type="integer"/>
      <column name="qr_issued_at" type="timestamp with time zone"/>
      <column name="qr_issued_by" type="varchar(255)"/>
    </addColumn>
    <sql><![CDATA[
      UPDATE inventory_item
      SET qr_public_id = gen_random_uuid(),
          qr_version   = 1,
          qr_issued_at = current_timestamp,
          qr_issued_by = COALESCE(NULLIF(insert_by, ''), 'migration');
      ]]></sql>
    <addNotNullConstraint tableName="inventory_item" columnName="qr_public_id" columnDataType="uuid"/>
    <addNotNullConstraint tableName="inventory_item" columnName="qr_version" columnDataType="integer"/>
    <addNotNullConstraint tableName="inventory_item" columnName="qr_issued_at"
                          columnDataType="timestamp with time zone"/>
    <addNotNullConstraint tableName="inventory_item" columnName="qr_issued_by" columnDataType="varchar(255)"/>
    <addUniqueConstraint tableName="inventory_item" columnNames="qr_public_id"
                         constraintName="uq_inventory_item_qr_public_id"/>
    <sql>ALTER TABLE inventory_item
      ADD CONSTRAINT ck_inventory_item_qr_version CHECK (qr_version &gt; 0);</sql>
  </changeSet>

  <changeSet id="20260906000000-2" author="taurus">
    <createTable tableName="inventory_qr_rotation">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="item_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="previous_version" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="new_version" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="previous_code_digest" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="new_code_digest" type="varchar(64)">
        <constraints nullable="false"/>
      </column>
      <column name="reason" type="varchar(500)">
        <constraints nullable="false"/>
      </column>
      <column name="rotated_at" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="rotated_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="inventory_qr_rotation" baseColumnNames="item_id"
                             referencedTableName="inventory_item" referencedColumnNames="id"
                             constraintName="fk_inventory_qr_rotation_item" onDelete="RESTRICT"/>
    <addUniqueConstraint tableName="inventory_qr_rotation" columnNames="item_id,new_version"
                         constraintName="uq_inventory_qr_rotation_version"/>
    <createIndex tableName="inventory_qr_rotation" indexName="idx_inventory_qr_rotation_item">
      <column name="item_id"/>
      <column name="new_version"/>
    </createIndex>
  </changeSet>

  <changeSet id="20260906000000-3" author="taurus">
    <createTable tableName="inventory_issue_report">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="item_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="assignment_id" type="bigint"/>
      <column name="reported_quantity" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="severity" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="varchar(2000)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="resolution_notes" type="varchar(2000)"/>
      <column name="acknowledged_at" type="timestamp with time zone"/>
      <column name="acknowledged_by" type="varchar(255)"/>
      <column name="resolved_at" type="timestamp with time zone"/>
      <column name="resolved_by" type="varchar(255)"/>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="inventory_issue_report" baseColumnNames="item_id"
                             referencedTableName="inventory_item" referencedColumnNames="id"
                             constraintName="fk_inventory_issue_item" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="inventory_issue_report" baseColumnNames="assignment_id"
                             referencedTableName="inventory_assignment" referencedColumnNames="id"
                             constraintName="fk_inventory_issue_assignment" onDelete="RESTRICT"/>
    <sql>ALTER TABLE inventory_issue_report
      ADD CONSTRAINT ck_inventory_issue_quantity CHECK (reported_quantity &gt; 0);</sql>
    <sql>ALTER TABLE inventory_issue_report
      ADD CONSTRAINT ck_inventory_issue_acknowledged CHECK (status &lt;&gt; 'ACKNOWLEDGED' OR
                                                            (acknowledged_at IS NOT NULL AND acknowledged_by IS NOT NULL));</sql>
    <sql>ALTER TABLE inventory_issue_report
      ADD CONSTRAINT ck_inventory_issue_terminal CHECK (status NOT IN ('RESOLVED', 'DISMISSED') OR
                                                        (resolution_notes IS NOT NULL AND resolved_at IS NOT NULL AND
                                                         resolved_by IS NOT NULL));</sql>
    <createIndex tableName="inventory_issue_report" indexName="idx_inventory_issue_item">
      <column name="item_id"/>
      <column name="status"/>
      <column name="severity"/>
      <column name="deleted"/>
    </createIndex>
    <createIndex tableName="inventory_issue_report" indexName="idx_inventory_issue_assignment">
      <column name="assignment_id"/>
      <column name="deleted"/>
    </createIndex>

    <createTable tableName="inventory_issue_photo">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="issue_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="media_asset_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="display_order" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="inventory_issue_photo" baseColumnNames="issue_id"
                             referencedTableName="inventory_issue_report" referencedColumnNames="id"
                             constraintName="fk_inventory_issue_photo_issue" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="inventory_issue_photo" baseColumnNames="media_asset_id"
                             referencedTableName="media_asset" referencedColumnNames="id"
                             constraintName="fk_inventory_issue_photo_media" onDelete="RESTRICT"/>
    <createIndex tableName="inventory_issue_photo" indexName="idx_inventory_issue_photo">
      <column name="issue_id"/>
      <column name="deleted"/>
      <column name="display_order"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>

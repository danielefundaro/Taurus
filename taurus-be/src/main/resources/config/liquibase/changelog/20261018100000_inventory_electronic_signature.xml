                             constraintName="fk_signature_document_act" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_document" baseColumnNames="frozen_media_asset_id"
                             referencedTableName="media_asset" referencedColumnNames="id"
                             constraintName="fk_signature_document_frozen_media" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_document" baseColumnNames="signed_media_asset_id"

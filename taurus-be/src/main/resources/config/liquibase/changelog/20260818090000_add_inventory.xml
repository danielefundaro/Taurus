    <sql dbms="postgresql">
      ALTER TABLE inventory_item
        ADD CONSTRAINT ck_inventory_item_quantity CHECK (total_quantity &gt;= 0);
      ALTER TABLE inventory_assignment
        ADD CONSTRAINT ck_inventory_assignment_quantity
        CHECK (assigned_quantity &gt; 0 AND returned_quantity &gt;= 0 AND returned_quantity &lt;= assigned_quantity);
      ALTER TABLE inventory_return
        ADD CONSTRAINT ck_inventory_return_quantity CHECK (quantity &gt; 0);
    </sql>

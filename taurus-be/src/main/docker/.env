DB_USERNAME: taurus
DB_PASSWORD: password
KEYCLOAK_ADMIN_USERNAME: admin
KEYCLOAK_ADMIN_PASSWORD: admin
KEYCLOAK_DB_USERNAME: taurus
KEYCLOAK_DB_PASSWORD: password
# Development only: key shared by the backend (application-dev.yml) and the OMR service; production sets its own.
SCORE_PLAYBACK_OMR_API_KEY: taurus-omr-development-key
# Published version of the OMR image (fundanie/taurus-omr); latest by default.
TAURUS_OMR_VERSION: latest

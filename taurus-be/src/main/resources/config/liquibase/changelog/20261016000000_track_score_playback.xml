<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20261016000000-1" author="taurus">
    <comment>Playback settings of instruments, tracks and parts.</comment>
    <addColumn tableName="instrument">
      <column name="transposition_semitones" type="smallint"/>
      <column name="bass_clef_transposition_semitones" type="smallint"/>
      <column name="sound_bank" type="smallint"/>
      <column name="sound_program" type="smallint"/>
      <column name="percussion_key" type="smallint"/>
    </addColumn>
    <addColumn tableName="track">
      <column name="tempo_bpm" type="smallint"/>
      <column name="reference_sheet_music_id" type="bigint"/>
    </addColumn>
    <addColumn tableName="sheet_music">
      <column name="current_score_version_id" type="bigint"/>
      <column name="transposition_override" type="smallint"/>
      <column name="sound_bank_override" type="smallint"/>
      <column name="sound_program_override" type="smallint"/>
    </addColumn>
    <sql><![CDATA[
      ALTER TABLE instrument
        ADD CONSTRAINT ck_instrument_transposition CHECK (transposition_semitones BETWEEN -36 AND 36),
        ADD CONSTRAINT ck_instrument_bass_clef_transposition CHECK (bass_clef_transposition_semitones BETWEEN -36 AND 36),
        ADD CONSTRAINT ck_instrument_sound_bank
          CHECK (sound_bank IS NULL OR (sound_bank BETWEEN 0 AND 16383 AND sound_program IS NOT NULL)),
        ADD CONSTRAINT ck_instrument_sound_program CHECK (sound_program BETWEEN 0 AND 127),
        ADD CONSTRAINT ck_instrument_percussion_key CHECK (percussion_key BETWEEN 27 AND 87);
      ALTER TABLE track
        ADD CONSTRAINT ck_track_tempo_bpm CHECK (tempo_bpm BETWEEN 20 AND 300);
      ALTER TABLE sheet_music
        ADD CONSTRAINT ck_sheet_music_transposition_override CHECK (transposition_override BETWEEN -36 AND 36),
        ADD CONSTRAINT ck_sheet_music_sound_bank_override
          CHECK (sound_bank_override IS NULL OR (sound_bank_override BETWEEN 0 AND 16383 AND sound_program_override IS NOT NULL)),
        ADD CONSTRAINT ck_sheet_music_sound_program_override CHECK (sound_program_override BETWEEN 0 AND 127);
      ]]></sql>
    <addForeignKeyConstraint baseTableName="track" baseColumnNames="reference_sheet_music_id"
                             referencedTableName="sheet_music" referencedColumnNames="id"
                             constraintName="fk_track_reference_sheet_music" onDelete="SET NULL"/>
  </changeSet>

  <changeSet id="20261016000000-2" author="taurus">
    <comment>Immutable MusicXML versions of a part, used for playback and correction.</comment>
    <createTable tableName="score_version">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="sheet_music_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="version_number" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="origin" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(16)">
        <constraints nullable="false"/>
      </column>
      <column name="media_asset_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="pages_fingerprint" type="varchar(64)"/>
      <column name="recognition_job_id" type="bigint"/>
      <column name="parent_version_id" type="bigint"/>
      <column name="source_file_name" type="varchar(255)"/>
      <column name="source_part_name" type="varchar(255)"/>
      <column name="measure_count" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="checks_json" type="text">
        <constraints nullable="false"/>
      </column>
      <column name="layout_json" type="text"/>
      <column name="approved_by" type="varchar(255)"/>
      <column name="approved_at" type="timestamp with time zone"/>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="score_version" baseColumnNames="sheet_music_id"
                             referencedTableName="sheet_music" referencedColumnNames="id"
                             constraintName="fk_score_version_sheet_music" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="score_version" baseColumnNames="media_asset_id"
                             referencedTableName="media_asset" referencedColumnNames="id"
                             constraintName="fk_score_version_media_asset" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="score_version" baseColumnNames="parent_version_id"
                             referencedTableName="score_version" referencedColumnNames="id"
                             constraintName="fk_score_version_parent" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="sheet_music" baseColumnNames="current_score_version_id"
                             referencedTableName="score_version" referencedColumnNames="id"
                             constraintName="fk_sheet_music_current_score_version" onDelete="SET NULL"/>
    <sql><![CDATA[
      ALTER TABLE score_version
        ADD CONSTRAINT ck_score_version_origin
          CHECK (origin IN ('OMR_AUDIVERIS', 'OMR_HOMR', 'UPLOAD_MUSICXML', 'UPLOAD_MIDI', 'CORRECTION')),
        ADD CONSTRAINT ck_score_version_status CHECK (status IN ('UNVERIFIED', 'APPROVED')),
        ADD CONSTRAINT ck_score_version_approval
          CHECK ((status = 'APPROVED') = (approved_by IS NOT NULL AND approved_at IS NOT NULL));
      CREATE UNIQUE INDEX uq_score_version_number ON score_version (sheet_music_id, version_number) WHERE deleted = FALSE;
      CREATE INDEX idx_score_version_sheet_music ON score_version (sheet_music_id, deleted);
      CREATE INDEX idx_score_version_media_asset ON score_version (media_asset_id);
      ]]></sql>
  </changeSet>

  <changeSet id="20261016000000-3" author="taurus">
    <comment>Fill the playback settings of existing instruments with the proposal computed from their name.</comment>
    <customChange class="com.fundaro.zodiac.taurus.config.changelog.InstrumentPlaybackDefaultsChange"/>
  </changeSet>
</databaseChangeLog>

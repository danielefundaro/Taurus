{
    "name": "taurus-fe",
    "version": "0.0.1",
    "scripts": {
        "ng": "ng",
        "prestart": "node scripts/fetch-soundfont.mjs",
        "start": "ng serve",
        "prebuild": "node scripts/fetch-soundfont.mjs",
        "build": "ng build",
        "update": "ng update",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "test": "ng test",
        "test:coverage": "node scripts/check-coverage.mjs",
        "check:tour-anchors": "node scripts/check-tour-anchors.mjs && node --test scripts/check-tour-anchors.test.mjs",
        "e2e": "playwright test --config e2e/playwright.config.ts --project=desktop --project=mobile",
        "e2e:matrix": "playwright test --config e2e/playwright.config.ts",
        "e2e:install": "playwright install --with-deps chromium firefox webkit"
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^22.2.6",
        "@angular/common": "^22.2.5",
        "@angular/compiler": "^22.2.5",
        "@angular/core": "^22.2.5",
        "@angular/forms": "^22.2.5",
        "@angular/platform-browser": "^22.2.5",
        "@angular/router": "^22.2.5",
        "@angular/service-worker": "^22.2.5",
        "@primeuix/themes": "^3.1.0",
        "chart.js": "4.6.1",
        "keycloak-angular": "^22.0.0",
        "keycloak-js": "^26.2.5",
        "lato-font": "^3.0.0",
        "ngx-extended-pdf-viewer": "^31.0.1",
        "primeicons": "^8.0.2",
        "primeng": "^22.1.4",
        "rxjs": "~7.8.2",
        "spessasynth_lib": "4.4.7",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.9.1",
        "verovio": "6.4.1",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular/build": "^22.2.6",
        "@angular/cli": "^22.2.6",
        "@angular/compiler-cli": "^22.2.5",
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/jasmine": "~6.0.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "istanbul-lib-instrument": "^6.0.3",
        "jasmine-core": "~6.3.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.3.0",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.4",
        "typescript": "~6.0.3"
    }
}

---
import { appLegalUrl } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// I termini dell'applicativo si scrivono e si versionano in Taurus: il vecchio indirizzo rimanda alla pagina pubblica.
const target = appLegalUrl('terms');
---

<BaseLayout title="Termini dell’applicativo" description="I termini di utilizzo della piattaforma Taurus sono pubblicati nell’applicativo, con tutte le versioni." redirectTo={target}>
  <section class="legal-hero">
    <div class="container-shell">
      <span class="eyebrow">Piattaforma Taurus</span>
      <h1 class="display-title">Termini dell’applicativo</h1>
      <p class="body-large">I termini di utilizzo sono pubblicati nell’applicativo, insieme alle versioni precedenti.</p>
      <p class="body-large"><a class="redirect-link" href={target}>Apri i termini dell’applicativo</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .redirect-link {
    font-weight: 700;
    text-decoration: underline;
  }
</style>

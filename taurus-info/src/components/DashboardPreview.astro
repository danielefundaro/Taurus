---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---

<div class="product-window" aria-label="Anteprima dell'interfaccia Taurus">
  <aside class="product-sidebar">
    <Brand compact light />
    <div class="sidebar-line selected"><Icon name="catalogue" size={17} /><span>Catalogo</span></div>
    <div class="sidebar-line"><Icon name="search" size={17} /><span>Ricerca</span></div>
    <div class="sidebar-line"><Icon name="instrument" size={17} /><span>Strumenti</span></div>
    <div class="sidebar-line"><Icon name="calendar" size={17} /><span>Calendario</span></div>
    <div class="sidebar-profile"><span>DF</span><i></i></div>
  </aside>
  <div class="product-content">
    <div class="product-toolbar">
      <div><small>Archivio</small><strong>Panoramica</strong></div>
      <div class="toolbar-search"><Icon name="search" size={16} /><span>Cerca nel catalogo…</span></div>
      <span class="avatar">DF</span>
    </div>
    <div class="metric-grid">
      <article><span class="metric-icon amber"><Icon name="catalogue" size={20} /></span><small>Album</small><strong>128</strong><em>+ 6 questo mese</em></article>
      <article><span class="metric-icon green"><Icon name="search" size={20} /></span><small>Tracce</small><strong>1.842</strong><em>Catalogo aggiornato</em></article>
      <article><span class="metric-icon coral"><Icon name="calendar" size={20} /></span><small>Prossimi eventi</small><strong>12</strong><em>3 questa settimana</em></article>
    </div>
    <div class="preview-grid">
      <article class="recent-card">
        <div class="card-title"><strong>Aggiunti di recente</strong><span>Vedi tutti</span></div>
        <div class="track-row"><span class="track-index">01</span><div><strong>Sinfonia in Re</strong><small>Orchestra · Partitura</small></div><time>Oggi</time></div>
        <div class="track-row"><span class="track-index">02</span><div><strong>Notturno d'estate</strong><small>Ensemble · Audio</small></div><time>Ieri</time></div>
        <div class="track-row"><span class="track-index">03</span><div><strong>Suite per archi</strong><small>Quartetto · Spartito</small></div><time>08 ago</time></div>
      </article>
      <article class="event-card">
        <div class="card-title"><strong>Calendario</strong><span>Agosto</span></div>
        <div class="event-date"><strong>18</strong><span>AGO</span></div>
        <div class="event-copy"><strong>Prova generale</strong><small>Auditorium · 18:30</small></div>
        <div class="attendance"><span></span><span></span><span></span><small>18 partecipanti</small></div>
      </article>
    </div>
  </div>
</div>

<style>
  .product-window {
    display: grid;
    min-width: 720px;
    grid-template-columns: 9.5rem 1fr;
    overflow: hidden;
    border: 1px solid rgba(23, 61, 49, 0.13);
    border-radius: 1.75rem;
    background: #f8faf8;
    box-shadow: 0 35px 90px rgba(24, 48, 39, 0.2);
  }

  .product-sidebar {
    display: flex;
    min-height: 31rem;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.3rem 1rem;
    color: rgba(255, 255, 255, 0.72);
    background: var(--color-moss-900);
  }

  .product-sidebar :global(.brand) {
    margin: 0 0 2rem 0.3rem;
  }

  .sidebar-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: 0.65rem;
    padding: 0.65rem 0.7rem;
    font-size: 0.72rem;
  }

  .sidebar-line.selected {
    color: white;
    background: rgba(255, 255, 255, 0.12);
  }

  .sidebar-profile {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
  }

  .sidebar-profile span,
  .avatar {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 800;
  }

  .sidebar-profile span { color: var(--color-moss-900); background: var(--color-moss-200); }
  .sidebar-profile i { width: 4rem; height: 0.35rem; border-radius: 1rem; background: rgba(255,255,255,.18); }

  .product-content { padding: 1.35rem; }

  .product-toolbar {
    display: grid;
    grid-template-columns: 1fr 13rem auto;
    align-items: center;
    gap: 1rem;
  }

  .product-toolbar div:first-child { display: flex; flex-direction: column; }
  .product-toolbar small { color: #82908a; font-size: .62rem; }
  .product-toolbar strong { margin-top: .15rem; font-size: .95rem; }
  .toolbar-search { display: flex; align-items: center; gap: .45rem; border: 1px solid #dfe7e3; border-radius: .7rem; padding: .55rem .7rem; color: #8a9791; font-size: .65rem; background: white; }
  .avatar { color: white; background: var(--color-moss-700); }

  .metric-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; margin-top: 1.5rem; }
  .metric-grid article { display: grid; grid-template-columns: auto 1fr; column-gap: .65rem; border: 1px solid #e5ebe8; border-radius: 1rem; padding: .85rem; background: white; }
  .metric-grid small { align-self: end; color: #718079; font-size: .58rem; }
  .metric-grid strong { grid-column: 2; font-size: 1.35rem; line-height: 1; }
  .metric-grid em { grid-column: 1 / -1; margin-top: .7rem; color: #83918b; font-size: .52rem; font-style: normal; }
  .metric-icon { display: grid; width: 2.2rem; height: 2.2rem; grid-row: span 2; place-items: center; border-radius: .7rem; }
  .metric-icon.amber { color: #8f5a09; background: #fbe7bd; }
  .metric-icon.green { color: #23614d; background: #ddf1e8; }
  .metric-icon.coral { color: #8c3f2b; background: #f7d7cf; }

  .preview-grid { display: grid; grid-template-columns: 1.45fr .8fr; gap: .8rem; margin-top: .8rem; }
  .recent-card, .event-card { border: 1px solid #e5ebe8; border-radius: 1rem; padding: 1rem; background: white; }
  .card-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: .8rem; font-size: .67rem; }
  .card-title span { color: var(--color-moss-500); font-size: .55rem; font-weight: 700; }
  .track-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .65rem; padding: .65rem 0; border-top: 1px solid #eef2f0; }
  .track-index { color: #a0aba6; font-family: var(--font-display); font-size: .7rem; }
  .track-row div { display: flex; flex-direction: column; }
  .track-row strong { font-size: .62rem; }
  .track-row small, .track-row time, .event-copy small { color: #88958f; font-size: .5rem; }
  .event-card { background: linear-gradient(145deg, #fff, #eef7f3); }
  .event-date { display: flex; align-items: baseline; gap: .35rem; margin-top: 1.4rem; color: var(--color-moss-700); }
  .event-date strong { font-family: var(--font-display); font-size: 2.8rem; font-weight: 500; line-height: 1; }
  .event-date span { font-size: .58rem; font-weight: 800; }
  .event-copy { display: flex; flex-direction: column; margin-top: .7rem; }
  .event-copy strong { font-size: .72rem; }
  .attendance { display: flex; align-items: center; margin-top: 2.1rem; }
  .attendance span { width: 1.35rem; height: 1.35rem; margin-right: -.3rem; border: 2px solid white; border-radius: 50%; background: var(--color-moss-200); }
  .attendance span:nth-child(2) { background: #f3d39e; }
  .attendance span:nth-child(3) { background: #e6b5a7; }
  .attendance small { margin-left: .65rem; color: #78867f; font-size: .5rem; }
</style>

        <constraints nullable="false"/>
      </column>
      <column name="signed_media_asset_id" type="bigint"/>
      <column name="sealed_media_asset_id" type="bigint"/>
      <column name="sealed_hash" type="varchar(64)"/>
      <column name="deleted" type="boolean" defaultValueBoolean="false">

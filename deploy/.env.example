# Valori dell'installazione, da copiare in `.env` e compilare. Nessun valore vero va versionato.
#
#   cp .env.example .env && chmod 600 .env
#
# Le variabili senza valore predefinito sono obbligatorie: `docker compose` si ferma dicendo quale
# manca, invece di avviare lo stack a metà.

# --- Versioni ---------------------------------------------------------------------------------
# La versione delle immagini di backend e frontend: il tag `v*.*.*` della release. Per fissare anche
# il digest, si usa la forma `1.2.3@sha256:…` nei manifest.
TAURUS_VERSION=
TAURUS_OMR_VERSION=
TAURUS_INFO_VERSION=latest
TAURUS_POSTGRES_VERSION=17.0
TAURUS_KEYCLOAK_VERSION=26.6.4
TAURUS_RABBITMQ_VERSION=4.0.7-management-alpine

# --- Indirizzo pubblico -----------------------------------------------------------------------
# L'origine che vede il browser, con lo schema e senza barra finale. È anche il prefisso con cui
# Keycloak costruisce le redirezioni e il backend i link di feed, QR e firme.
TAURUS_PUBLIC_URL=https://taurus.esempio.it
# Solo per `extra_hosts`, se il nome pubblico non si risolve dall'interno della rete Docker.
TAURUS_PUBLIC_HOSTNAME=taurus.esempio.it
# La porta del loopback su cui il reverse proxy dell'host inoltra.
TAURUS_HTTP_PORT=8081
TAURUS_INFO_HTTP_PORT=8082

# --- PostgreSQL -------------------------------------------------------------------------------
TAURUS_DB_NAME=taurus
TAURUS_DB_USERNAME=taurus
TAURUS_DB_PASSWORD=
# Pool del backend; `max_connections` deve coprire pool x repliche più Keycloak.
TAURUS_DB_POOL_MAX=20
TAURUS_DB_MAX_CONNECTIONS=200

# --- Keycloak ---------------------------------------------------------------------------------
TAURUS_REALM=taurus
TAURUS_KEYCLOAK_DB_NAME=taurus_keycloak
TAURUS_KEYCLOAK_DB_USERNAME=keycloak
TAURUS_KEYCLOAK_DB_PASSWORD=
# Primo amministratore, creato al primissimo avvio: cambiare la password dall'interfaccia e togliere
# queste variabili appena il realm è in piedi.
TAURUS_KEYCLOAK_ADMIN_USERNAME=
TAURUS_KEYCLOAK_ADMIN_PASSWORD=
# Il client dell'applicazione, lo stesso del realm e del frontend.
TAURUS_OIDC_CLIENT_ID=web_app
TAURUS_OIDC_CLIENT_SECRET=

# --- RabbitMQ ---------------------------------------------------------------------------------
TAURUS_RABBITMQ_USERNAME=taurus
TAURUS_RABBITMQ_PASSWORD=

# --- Notifiche push ---------------------------------------------------------------------------
# Coppia di chiavi VAPID dell'installazione: npx web-push generate-vapid-keys
TAURUS_VAPID_PUBLIC_KEY=
TAURUS_VAPID_PRIVATE_KEY=
TAURUS_VAPID_SUBJECT=mailto:tecnico@esempio.it

# --- Ascolto delle parti (servizio OMR) -------------------------------------------------------
TAURUS_SCORE_PLAYBACK_ENABLED=true
# Almeno 16 caratteri: la stessa chiave per il servizio e per il backend che lo chiama.
TAURUS_OMR_API_KEY=
TAURUS_OMR_CONCURRENCY=1

# --- QR inventario ----------------------------------------------------------------------------
TAURUS_INVENTORY_QR_ENABLED=true

# --- Posta ------------------------------------------------------------------------------------
# Senza un server configurato l'applicazione parte, ma i codici e i link della firma elettronica e
# le notifiche per posta non vengono inviati.
TAURUS_MAIL_HOST=
TAURUS_MAIL_PORT=587
TAURUS_MAIL_USERNAME=
TAURUS_MAIL_PASSWORD=
TAURUS_MAIL_STARTTLS=true
TAURUS_MAIL_FROM=taurus@esempio.it

# --- Firma elettronica (facoltativa) ----------------------------------------------------------
# Segreto con cui si cifrano i codici della firma e credenziali del client che verifica gli OTP.
TAURUS_SIGNATURE_OTP_SECRET=
TAURUS_SIGNATURE_KEYCLOAK_CLIENT_SECRET=

# --- Limiti di risorsa ------------------------------------------------------------------------
TAURUS_BACKEND_MEMORY_LIMIT=2g
TAURUS_FRONTEND_MEMORY_LIMIT=256m
TAURUS_INFO_MEMORY_LIMIT=128m
TAURUS_DB_MEMORY_LIMIT=2g
TAURUS_KEYCLOAK_MEMORY_LIMIT=1g
TAURUS_RABBITMQ_MEMORY_LIMIT=1g
TAURUS_OMR_CPUS=4
TAURUS_OMR_MEMORY_LIMIT=6g
TAURUS_OMR_TMPFS_SIZE=2g
# Deve coprire il caricamento più grande ammesso dal backend (500 MB).
TAURUS_MAX_UPLOAD_SIZE=500m

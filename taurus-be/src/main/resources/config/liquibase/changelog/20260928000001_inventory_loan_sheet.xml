  <changeSet id="20260928000001-4" author="taurus" dbms="postgresql">
    <comment>Partial unique indexes and consistency checks of the loan sheet.</comment>
    <sql><![CDATA[
      CREATE UNIQUE INDEX uq_inventory_loan_template_hash
        ON inventory_loan_template (origin, content_hash)
        WHERE deleted = false;
      CREATE UNIQUE INDEX uq_inventory_loan_template_version
        ON inventory_loan_template (version_number)
        WHERE deleted = false AND version_number IS NOT NULL;
      CREATE UNIQUE INDEX uq_inventory_loan_settings_single
        ON inventory_loan_settings ((true))
        WHERE deleted = false;
      CREATE UNIQUE INDEX uq_inventory_loan_sheet_issued_user
        ON inventory_loan_sheet (user_index)
        WHERE deleted = false AND status = 'ISSUED';
      ALTER TABLE inventory_loan_template
        ADD CONSTRAINT ck_inventory_loan_template_origin CHECK (
          (origin = 'CUSTOM' AND version_number IS NOT NULL) OR (origin = 'DEFAULT' AND version_number IS NULL AND default_label IS NOT NULL)
        );
      ALTER TABLE inventory_loan_settings
        ADD CONSTRAINT ck_inventory_loan_settings_duration CHECK (
          min_months >= 1 AND min_months <= max_months AND max_months <= total_max_months
          AND renewal_max_months >= 1 AND renewal_max_months <= total_max_months AND total_max_months <= 120
        );
      ALTER TABLE inventory_loan_sheet
        ADD CONSTRAINT ck_inventory_loan_sheet_duration CHECK (
          min_months >= 1 AND min_months <= max_months AND max_months <= total_max_months
          AND renewal_max_months >= 1 AND renewal_max_months <= total_max_months AND total_max_months <= 120
        );
      ALTER TABLE inventory_loan_sheet
        ADD CONSTRAINT ck_inventory_loan_sheet_charges CHECK (
          return_outcome IS DISTINCT FROM 'CHARGES' OR (charge_amount > 0 AND charge_due_date IS NOT NULL)
        );
      ALTER TABLE inventory_loan_sheet
        ADD CONSTRAINT ck_inventory_loan_sheet_closed CHECK (
          status NOT IN ('CLOSED', 'SETTLED') OR (closed_at IS NOT NULL AND return_outcome IS NOT NULL)
        );
      ALTER TABLE inventory_loan_sheet_line
        ADD CONSTRAINT ck_inventory_loan_sheet_line_quantity CHECK (quantity > 0);
      ]]></sql>
  </changeSet>
</databaseChangeLog>

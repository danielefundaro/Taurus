<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260824000000-1" author="taurus">
    <createTable schemaName="public" tableName="tenant">
      <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="deleted" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="insert_by" type="varchar(255)"/>
      <column name="insert_date" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
      <column name="edit_by" type="varchar(255)"/>
      <column name="edit_date" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
      <column name="entity_version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
      <column name="name" type="varchar(255)"><constraints nullable="false"/></column>
      <column name="description" type="varchar(4000)"/>
      <column name="code" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
      <column name="email" type="varchar(255)"/>
      <column name="domain" type="varchar(255)"/>
      <column name="max_users" type="bigint"/>
      <column name="expire_date" type="date"/>
      <column name="active" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
      <column name="address" type="varchar(500)"/>
      <column name="postal_code" type="varchar(32)"/>
      <column name="city" type="varchar(255)"/>
      <column name="province" type="varchar(255)"/>
      <column name="country" type="varchar(2)"/>
      <column name="tax_code" type="varchar(32)"/>
      <column name="vat_number" type="varchar(32)"/>
      <column name="logo_url" type="varchar(2048)"/>
    </createTable>
    <createIndex schemaName="public" tableName="tenant" indexName="idx_tenant_active_name">
      <column name="active"/><column name="deleted"/><column name="name"/>
    </createIndex>

    <createTable schemaName="public" tableName="user_identity">
      <column name="id" type="bigint" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="keycloak_id" type="varchar(255)"><constraints nullable="false" unique="true"/></column>
      <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
      <column name="deleted_at" type="timestamp with time zone"/>
    </createTable>

    <createTable schemaName="public" tableName="tenant_user_membership">
      <column name="tenant_id" type="bigint"><constraints nullable="false"/></column>
      <column name="user_identity_id" type="bigint"><constraints nullable="false"/></column>
      <column name="active" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
      <column name="joined_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
      <column name="left_at" type="timestamp with time zone"/>
    </createTable>
    <addPrimaryKey schemaName="public" tableName="tenant_user_membership" columnNames="tenant_id,user_identity_id" constraintName="pk_tenant_user_membership"/>
    <addForeignKeyConstraint baseTableSchemaName="public" baseTableName="tenant_user_membership" baseColumnNames="tenant_id" referencedTableSchemaName="public" referencedTableName="tenant" referencedColumnNames="id" constraintName="fk_membership_tenant" onDelete="CASCADE"/>
    <addForeignKeyConstraint baseTableSchemaName="public" baseTableName="tenant_user_membership" baseColumnNames="user_identity_id" referencedTableSchemaName="public" referencedTableName="user_identity" referencedColumnNames="id" constraintName="fk_membership_identity" onDelete="CASCADE"/>

    <addColumn schemaName="public" tableName="tenant_schema_registry">
      <column name="tenant_id" type="bigint"/>
    </addColumn>
    <addForeignKeyConstraint baseTableSchemaName="public" baseTableName="tenant_schema_registry" baseColumnNames="tenant_id" referencedTableSchemaName="public" referencedTableName="tenant" referencedColumnNames="id" constraintName="fk_tenant_schema_registry_tenant" onDelete="CASCADE"/>
    <addUniqueConstraint schemaName="public" tableName="tenant_schema_registry" columnNames="tenant_id" constraintName="uq_tenant_schema_registry_tenant"/>
  </changeSet>
</databaseChangeLog>

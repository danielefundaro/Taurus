      </column>
      <column name="act_type" type="varchar(32)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(24)">
        <constraints nullable="false"/>
      </column>
      <column name="sheet_id" type="bigint"/>
      <column name="assignment_id" type="bigint"/>
      <column name="renewal_id" type="bigint"/>
      <column name="return_id" type="bigint"/>
      <column name="decision_id" type="bigint"/>
      <column name="template_id" type="bigint"/>
      <column name="template_hash" type="varchar(64)"/>
      <column name="attestation_media_asset_id" type="bigint"/>
      <column name="completed_at" type="timestamp with time zone"/>
      <column name="paper_note" type="varchar(2000)"/>
      <column name="purge_after" type="timestamp with time zone"/>
      <column name="purged_at" type="timestamp with time zone"/>
      <column name="cancelled_at" type="timestamp with time zone"/>
      <column name="entity_version" type="bigint" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="deleted" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="insert_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="insert_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
      <column name="edit_date" type="timestamp with time zone">
        <constraints nullable="false"/>
      </column>
      <column name="edit_by" type="varchar(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="sheet_id"
                             referencedTableName="inventory_loan_sheet" referencedColumnNames="id"
                             constraintName="fk_signature_act_sheet" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="assignment_id"
                             referencedTableName="inventory_assignment" referencedColumnNames="id"
                             constraintName="fk_signature_act_assignment" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="renewal_id"
                             referencedTableName="inventory_assignment_renewal" referencedColumnNames="id"
                             constraintName="fk_signature_act_renewal" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="return_id"
                             referencedTableName="inventory_return" referencedColumnNames="id"
                             constraintName="fk_signature_act_return" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="decision_id"
                             referencedTableName="inventory_assignment_decision" referencedColumnNames="id"
                             constraintName="fk_signature_act_decision" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="template_id"
                             referencedTableName="inventory_loan_template" referencedColumnNames="id"
                             constraintName="fk_signature_act_template" onDelete="RESTRICT"/>
    <addForeignKeyConstraint baseTableName="signature_act" baseColumnNames="attestation_media_asset_id"
                             referencedTableName="media_asset" referencedColumnNames="id"
                             constraintName="fk_signature_act_attestation" onDelete="RESTRICT"/>

    <createTable tableName="signature_document">

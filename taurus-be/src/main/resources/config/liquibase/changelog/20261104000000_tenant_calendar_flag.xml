<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20261104000000-1" author="taurus">
    <comment>Per-tenant switch for the calendar of the events.</comment>
    <addColumn schemaName="public" tableName="tenant">
      <column name="calendar_enabled" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <rollback>
      <dropColumn schemaName="public" tableName="tenant" columnName="calendar_enabled"/>
    </rollback>
  </changeSet>

  <changeSet id="20261104000000-2" author="taurus">
    <comment>The calendar was always on: every existing tenant keeps it.</comment>
    <update schemaName="public" tableName="tenant">
      <column name="calendar_enabled" valueBoolean="true"/>
    </update>
    <rollback/>
  </changeSet>
</databaseChangeLog>

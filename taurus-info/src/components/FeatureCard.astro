---
import Icon from './Icon.astro';

interface Props {
  icon: 'catalogue' | 'search' | 'instrument' | 'calendar' | 'users' | 'shield' | 'inventory' | 'finance' | 'bell' | 'document' | 'dashboard';
  title: string;
  description: string;
  number?: string;
}

const { icon, title, description, number } = Astro.props;
---

<article class="feature-card">
  <div class="feature-top">
    <span class="feature-icon"><Icon name={icon} size={27} /></span>
    {number && <span class="feature-number">{number}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .feature-card {
    min-height: 18rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border: 1px solid rgba(23, 61, 49, 0.1);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.72);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    border-color: rgba(35, 97, 77, 0.25);
    box-shadow: var(--shadow-soft);
  }

  .feature-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feature-icon {
    display: grid;
    width: 3.3rem;
    height: 3.3rem;
    place-items: center;
    border-radius: 1rem;
    color: var(--color-moss-700);
    background: var(--color-moss-100);
  }

  .feature-number {
    color: rgba(23, 61, 49, 0.28);
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  h3 {
    margin: 2.7rem 0 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  p {
    margin: 0.9rem 0 0;
    color: var(--color-ink-600);
    line-height: 1.72;
  }
</style>
